{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["opencode.md", ".opencode/references/api-contract.md"],
  "permission": {
    "read": {
      "/home/matheus/**": "allow"
    },
    "bash": {
      "npm -v": "allow",
      "npm config *": "allow",
      "npm run *": "allow",
      "npx prisma *": "allow",
      "npx prisma migrate reset": "ask",
      "npx prisma db push": "ask",
      "npx prisma db drop": "ask",
      "node -e *": "allow"
    }
  }
}
