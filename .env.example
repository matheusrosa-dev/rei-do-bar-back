API_PORT=3333
# API_DELAY=1000

DATABASE_URL="postgresql://postgres:root@localhost:5432/rei_do_bar?schema=public"
EXPO_ACCESS_TOKEN=expo-access-token

AUTH_JWT_SECRET=secret-key-for-jwt-signing
AUTH_JWT_REFRESH_SECRET=secret-key-for-refresh-token-signing
AUTH_OTP_EXPIRATION_MINUTES=5
AUTH_JWT_EXPIRATION_TIME=900s # 15 minutes
AUTH_JWT_REFRESH_EXPIRATION_TIME=30d # 30 days

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Rate limiting (TTL em segundos).
RATE_LIMIT_DEVICE_SYNC_LIMIT=20
RATE_LIMIT_DEVICE_SYNC_TTL=60

RATE_LIMIT_OTP_SEND_LIMIT=1
RATE_LIMIT_OTP_SEND_TTL=20

RATE_LIMIT_OTP_SEND_LONG_LIMIT=5
RATE_LIMIT_OTP_SEND_LONG_TTL=3600

RATE_LIMIT_OTP_LOGIN_LIMIT=10
RATE_LIMIT_OTP_LOGIN_TTL=600

RATE_LIMIT_ADMIN_LIMIT=5
RATE_LIMIT_ADMIN_TTL=60