// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/shared/database/prisma/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id        String    @id @default(uuid())
  name      String?
  phone     String    @unique()
  isActive  Boolean   @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  cart            Cart?
  addresses       Address[]
  orders          Order[]
  refreshTokens   RefreshToken[]
  pushTokens      PushToken[]
  couponUsages    CouponUsage[]
  eligibleCoupons CouponCustomer[]

  @@map("customers")
}

model AnonymousCustomer {
  id        String   @id @default(uuid())
  deviceId  String   @unique @map("device_id")
  createdAt DateTime @default(now()) @map("created_at")

  cart     Cart?
  otpCodes OtpCode[]

  @@map("anonymous_customers")
}

model RefreshToken {
  id          String   @id @default(uuid())
  customerId  String   @map("customer_id")
  hashedToken String   @unique
  createdAt   DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("refresh_tokens")
}

model PushToken {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  token      String   @unique
  deviceId   String   @map("device_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("push_tokens")
}

model OtpCode {
  id                  String   @id @default(uuid())
  anonymousCustomerId String   @map("anonymous_customer_id")
  hashedCode          String   @unique
  expiresAt           DateTime @map("expires_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  anonymousCustomer AnonymousCustomer @relation(fields: [anonymousCustomerId], references: [id], onDelete: Cascade)

  @@index([anonymousCustomerId])
  @@map("otp_codes")
}

model Address {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  street       String
  number       String
  complement   String?
  neighborhood String
  zipCode      String   @map("zip_code")
  isMain       Boolean  @map("is_main")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

model Cart {
  id                  String   @id @default(uuid())
  customerId          String?  @unique @map("customer_id")
  anonymousCustomerId String?  @unique @map("anonymous_customer_id")
  couponId            String?  @map("coupon_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  anonymousCustomer AnonymousCustomer? @relation(fields: [anonymousCustomerId], references: [id])
  coupon            Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items             CartItem[]

  @@map("cart")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Category {
  id         String   @id @default(uuid())
  name       String   @unique
  pluralName String   @map("plural_name")
  imageUrl   String   @map("image_url")
  isActive   Boolean  @map("is_active")
  sortOrder  Int      @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id             String    @id @default(uuid())
  categoryId     String    @map("category_id")
  name           String
  description    String?
  price          Int
  compareAtPrice Int?      @map("compare_at_price")
  stockQuantity  Int       @map("stock_quantity")
  imageUrl       String    @map("image_url")
  sortOrder      Int       @map("sort_order")
  isActive       Boolean   @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  category           Category                   @relation(fields: [categoryId], references: [id])
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovementProduct[]

  @@index([categoryId])
  @@map("products")
}

model InventoryMovement {
  id        String                  @id @default(uuid())
  origin    InventoryMovementOrigin
  orderId   String?                 @map("order_id")
  createdAt DateTime                @default(now()) @map("created_at")

  order    Order?                     @relation(fields: [orderId], references: [id])
  products InventoryMovementProduct[]

  @@index([orderId])
  @@map("inventories")
}

model InventoryMovementProduct {
  id                  String   @id @default(uuid())
  inventoryMovementId String   @map("inventory_movement_id")
  productId           String   @map("product_id")
  quantity            Int
  price               Int
  createdAt           DateTime @default(now()) @map("created_at")

  inventoryMovement InventoryMovement @relation(fields: [inventoryMovementId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id])

  @@unique([inventoryMovementId, productId])
  @@map("inventory_movement_products")
}

model Order {
  id                  String      @id @default(uuid())
  orderNumber         Int         @unique @default(autoincrement()) @map("order_number")
  customerId          String      @map("customer_id")
  address             String
  status              OrderStatus
  statusReason        String?     @map("status_reason")
  deliveryFee         Int         @map("delivery_fee")
  deliveryPersonBonus Int         @default(0) @map("delivery_person_bonus")
  couponId            String?     @map("coupon_id")
  couponCode          String?     @map("coupon_code")
  couponDiscount      Int         @map("coupon_discount")
  paymentType         PaymentType @map("payment_type")
  deliveryPersonId    String?     @map("delivery_person_id")
  shippedAt           DateTime?   @map("shipped_at")
  deliveredAt         DateTime?   @map("delivered_at")
  cancelledAt         DateTime?   @map("cancelled_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  customer           Customer            @relation(fields: [customerId], references: [id])
  coupon             Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  deliveryPerson     DeliveryPerson?     @relation(fields: [deliveryPersonId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([customerId])
  @@index([couponId])
  @@index([deliveryPersonId])
  @@index([status, deliveredAt])
  @@index([status, cancelledAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String   @map("order_id")
  productId      String   @map("product_id")
  name           String
  imageUrl       String   @map("image_url")
  quantity       Int
  price          Int
  compareAtPrice Int?     @map("compare_at_price")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@map("order_items")
}

model DeliveryPerson {
  id                  String   @id @default(uuid())
  name                String
  phone               String   @unique
  cpf                 String   @unique
  hashedPassword      String?  @map("hashed_password")
  addressStreet       String   @map("address_street")
  addressNumber       String   @map("address_number")
  addressNeighborhood String   @map("address_neighborhood")
  addressZipCode      String   @map("address_zip_code")
  isActive            Boolean  @map("is_active")
  isVolunteer         Boolean  @default(false) @map("is_volunteer")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  orders  Order[]
  session DeliveryPersonSession?

  @@map("delivery_persons")
}

model DeliveryPersonSession {
  id                    String   @id @default(uuid())
  deliveryPersonId      String   @unique @map("delivery_person_id")
  hashedAccessToken     String   @unique @map("hashed_access_token")
  hashedRefreshToken    String   @unique @map("hashed_refresh_token")
  accessTokenExpiresAt  DateTime @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime @map("refresh_token_expires_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  deliveryPerson DeliveryPerson @relation(fields: [deliveryPersonId], references: [id], onDelete: Cascade)

  @@map("delivery_person_sessions")
}

model Coupon {
  id            String             @id @default(uuid())
  code          String             @unique
  discountType  CouponDiscountType @map("discount_type")
  discountValue Int                @map("discount_value")
  minOrderValue Int                @map("min_order_value")
  startsAt      DateTime           @map("starts_at")
  endsAt        DateTime?          @map("ends_at")
  usageLimit    Int?               @map("usage_limit")
  isActive      Boolean            @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  usages            CouponUsage[]
  carts             Cart[]
  orders            Order[]
  eligibleCustomers CouponCustomer[]

  @@map("coupons")
}

model CouponUsage {
  id         String   @id @default(uuid())
  couponId   String   @map("coupon_id")
  customerId String   @map("customer_id")
  createdAt  DateTime @default(now()) @map("created_at")

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([couponId, customerId])
  @@index([customerId])
  @@map("coupon_usages")
}

model CouponCustomer {
  couponId   String   @map("coupon_id")
  customerId String   @map("customer_id")
  createdAt  DateTime @default(now()) @map("created_at")

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([couponId, customerId])
  @@index([customerId])
  @@map("coupon_customers")
}

model Setting {
  id        String      @id @default(uuid())
  key       SettingKey  @unique
  type      SettingType
  value     String
  isActive  Boolean     @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("settings")
}

model Notification {
  id             String              @id @default(uuid())
  target         NotificationTarget
  title          String
  description    String
  action         NotificationAction?
  status         NotificationStatus
  customersCount Int                 @map("customers_count")
  createdAt      DateTime            @default(now()) @map("created_at")

  @@map("notifications")
}

enum SettingKey {
  ALERT_MESSAGE
  WHATSAPP_CONTACT
  OUTSIDE_BUSINESS_HOURS
  ON_BREAK

  WELCOME_COUPON
  MIN_ORDER_VALUE
  DELIVERY_FEE
  DELIVERY_PERSON_BONUS
}

enum SettingType {
  CURRENCY
  TEXT
  PHONE
}

enum CouponDiscountType {
  FIXED
  PERCENTAGE
}

enum PaymentType {
  CASH
  CARD
  PIX
}

enum InventoryMovementOrigin {
  ORDER_CREATION
  ORDER_CANCELLATION
  ADMIN_ORDER_CANCELLATION
  ADMIN_RESTOCK
  ADMIN_REMOVAL
}

enum OrderStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum NotificationTarget {
  ALL
  NO_ORDERS
  ABANDONED_CART
  INACTIVE_30_DAYS
  SINGLE_ORDER
}

enum NotificationAction {
  REDIRECT_TO_ORDERS
}

enum NotificationStatus {
  SENT
  FAILED
}
